    # PerfCtrl3 @ memtile (19,1) (ctr4 = Combo_Event_2 lock stall excluding starvation and backpressure)
    write_reg(0x002619100c, 0x00000b0b)
    # DMA_Event_Channel_Selection @ memtile (19,2) (mm2s sel0 = ch0)
    write_reg(0x00262a06a0, 0x00000000)
    # SS port sel @ memtile (19,2) (slot0 = mm2s ch0 slave port_running)
    write_reg(0x00262b0f00, 0x00000000)
    # Combo_Event_Inputs @ memtile (19,2) (A,B = mm2s lock stall, C = mm2s memory starvation, D = mm2s stream backpressure)
    # Combo_Event_Control @ memtile (19,2) (combo0 = A AND B = lock stall, combo1 = C OR D = starvation or backpressure, combo2 = combo0 AND NOT combo1)
    write_mem(0x0026294400, 2, config)
    # Reset PerfCounter0-5 @ memtile (19,2)
    write_mem(0x0026291020, 5, reset)
    # PerfCtrl0 @ memtile (19,2) (ctr0 = port_running, ctr1 = memory starvation)
    write_reg(0x0026291000, 0x2b2b5050)
    # PerfCtrl1 @ memtile (19,2) (ctr2 = stream backpressure, ctr3 = lock stall)
    write_reg(0x0026291004, 0x23232727)
    # PerfCtrl3 @ memtile (19,2) (ctr4 = Combo_Event_2 lock stall excluding starvation and backpressure)
    write_reg(0x002629100c, 0x00000b0b)

