{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "aie2p_ctrlcode",
      "camelcase": "Aie2pCtrlcode",
      "title": "Aie2pCtrlcode",
      "scope": "source.aie2p_ctrlcode",
      "file-types": [
        "asm"
      ],
      "injection-regex": "^aie2p_ctrlcode$",
      "class-name": "TreeSitterAie2pCtrlcode"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "AMD XDNA aie2p ctrlcode parser for tree-sitter",
    "authors": [
      {
        "name": "Sonal Santan"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-aie2p_ctrlcode"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
