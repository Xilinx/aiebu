{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "aie4_ctrlcode",
      "camelcase": "Aie4Ctrlcode",
      "title": "Aie4Ctrlcode",
      "scope": "source.aie4_ctrlcode",
      "file-types": [
        "asm"
      ],
      "injection-regex": "^aie4_ctrlcode$",
      "class-name": "TreeSitterAie4Ctrlcode"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "AMD XDNA aie4 / aie2ps ctrlcode parser for tree-sitter",
    "authors": [
      {
        "name": "Sonal Santan"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-aie4_ctrlcode"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
